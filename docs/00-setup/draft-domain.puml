@startuml
!include ../../_style.puml
hide circle

class Заказ {
  + id : String
  + статус : String
}
class ПозицияЗаказа {
  + количество : int
}
class Блюдо {
  + название : String
}
class Клиент {
  + телефон : String
}
class Курьер {
  + статус : String
}

Клиент "1" -- "0..*" Заказ
Заказ "1" *-- "1..*" ПозицияЗаказа
ПозицияЗаказа "0..*" -- "1" Блюдо
Курьер "0..1" -- "0..*" Заказ
@enduml
