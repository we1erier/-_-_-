@startuml
!include ../../_style.puml
hide circle

package "delivery" {
  abstract class Пользователь {
    + телефон : String
  }
  class Клиент {
    + адрес : String
  }
  class Курьер {
    + транспорт : String
  }
}

package "orders" {
  class Заказ {
    + статус : СтатусЗаказа
  }
  class ПозицияЗаказа {
    + количество : int
  }
  class Блюдо {
    + цена : double
  }
  enum СтатусЗаказа {
    ОФОРМЛЕН
    В_ПУТИ
    ОТМЕНЁН
  }
}

Клиент --|> Пользователь
Курьер --|> Пользователь
Заказ "1" *-- "1..*" ПозицияЗаказа
ПозицияЗаказа "0..*" -- "1" Блюдо
Клиент "1" -- "0..*" Заказ : оформляет >
Курьер "0..1" o-- "0..*" Заказ : доставляет >
delivery ..> orders : <<use>>
@enduml
